# =============================================================================
# MyChat 服务端部署变量
#   cp .env.example .env  然后改掉密码和 PUBLIC_HOST
#   docker compose --env-file .env up -d
# =============================================================================

# 镜像 tag（build-images.sh 用同一个值打 tag）
MYCHAT_TAG=latest

# ---------------------------------------------------------------- 对外地址
# 云服务器的公网 IP 或域名。客户端拿到的聊天服地址就是它，填错会导致登录后连不上聊天服
PUBLIC_HOST=127.0.0.1

# 对外暴露的端口：GateServer（HTTP/WebSocket 入口）与两台 ChatServer（客户端直连）
GATE_PORT=20060
CHAT1_PORT=20631
CHAT2_PORT=20632

# ---------------------------------------------------------------- 内部端口
# 只在 compose 网络内部使用，不映射到宿主机
STATUS_PORT=50052
VERIFY_PORT=50051
CHAT1_GRPC_PORT=20641
CHAT2_GRPC_PORT=20642

# 容器内服务发现用的名字（一般不用改；改了要同步 compose 里的 service 名）
MYSQL_HOST=mysql
MYSQL_PORT=3306
# MySQL 额外绑在宿主机 127.0.0.1 上的端口，给 CLion / DataGrip 的 SSH 隧道用。
# 只绑 loopback，公网依然连不上；不想开就把这行注释掉（compose 里用 ${MYSQL_PUBLISH_PORT:-3306}）
MYSQL_PUBLISH_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
VERIFY_HOST=verify
STATUS_HOST=status
PEER_CHAT1_HOST=chat1
PEER_CHAT2_HOST=chat2

# ---------------------------------------------------------------- 账号密码
# MySQL：代码里用户名写死 root、库名写死 chatserver（MySqlManager.cpp:9-14），
# 所以这里只能改密码，用户名/库名不要改
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456

# ---------------------------------------------------------------- 验证码邮件
# verifyserver 用 163 SMTP 发验证码。留空也能起，只是 /get_Verifycode 会告警不发信；
# 注意：真实密码只放服务器上的 .env，不要提交进仓库
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------- 基础镜像
# 服务器能直连 docker.io 就用默认值；不能直连时换成自己的镜像加速前缀
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:8.0

# ---------------------------------------------------------------- 其它
# spdlog 日志级别：0=trace 1=info 2=warn 3=err 4=critical 5=off
# Release 构建里 SPDLOG_ACTIVE_LEVEL=OFF，日志实际不输出，这里只影响 Debug 镜像
LOG_LEVEL=1
